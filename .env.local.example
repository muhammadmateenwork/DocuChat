# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (chat completions) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Primary model, then comma-separated fallbacks tried in order if the primary
# fails (e.g. unavailable/rate-limited). Defaults below are all free-tier
# (":free") models, for accounts without paid OpenRouter credit.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free,liquid/lfm-2.5-2.6b:free
# Free-tier model availability on OpenRouter changes often — re-check
# https://openrouter.ai/api/v1/models (filter for ids ending in ":free") if
# these stop working.

# Google AI Studio (free embeddings) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Seeded demo organization id (set after running scripts/seed-demo.ts)
DEMO_ORG_ID=
